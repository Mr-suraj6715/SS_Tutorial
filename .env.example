# SS Tutorial Backend Environment Variables
# Copy this to .env and update values for production

PORT=5000
NODE_ENV=development
JWT_SECRET=ss_tutorial_production_jwt_secret_change_in_prod_2026

# Frontend Vite Dev Server runs on 5173 by default
# VITE_API_URL is used by the React frontend to call the backend
VITE_API_URL=http://localhost:5000