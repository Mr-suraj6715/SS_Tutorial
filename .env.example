# SS Tutorial Environment Configuration

# Server Port & Mode
PORT=5000
NODE_ENV=development
JWT_SECRET=ss_tutorial_production_jwt_secret_change_in_prod_2026

# React Frontend API URL
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID (from Google Cloud Console)
# Authorized JavaScript Origins: http://localhost:3000
# Authorized Redirect URIs: http://localhost:3000/auth
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── SUPABASE CONFIGURATION (Cloud Database & Storage) ─────────────────────────
# When configured, frontend and backend connect to Supabase.
# When empty or offline, the app automatically falls back to local SQLite.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here